{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shramee/zk-audit/schemas/ledger.schema.json",
  "$comment": "Coverage ledger of deterministic units, adapted from Cloudflare security-audit-skill's coverage ledger (MIT). Units are circuit|gadget x constraint-class and contract-fn x integration-class. `gnark-inventory validate ledger` checks this schema plus semantic rules (unique ids, classes and lenses known to profiles.json, evidence for covered units, reasons for skipped units, at least one unit; with --out, agent outputs and PoC files on disk).",
  "title": "zk-audit coverage-ledger.json",
  "type": "object",
  "required": ["schema_version", "repo", "generated_by", "units"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "repo": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string" },
    "profile": { "type": "string" },
    "generated_by": { "type": "string", "minLength": 1 },
    "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "unit": {
      "type": "object",
      "required": ["id", "kind", "subject", "class", "lenses", "paths", "status", "agent_ids", "reviewed_paths", "result_fingerprints"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z-]+:[^|]+\\|[a-z0-9-]+$" },
        "kind": { "enum": ["circuit", "hint", "public-input", "contract-fn", "verifier", "prover", "dependency"] },
        "subject": { "$ref": "#/$defs/nonEmpty" },
        "class": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "A ledger class owned by one lens in the tool's profiles.json (`gnark-inventory profiles`); `validate ledger` checks membership"
        },
        "lenses": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "description": "Lens ids from profiles.json, or V for the vector scan; `validate ledger` checks membership"
        },
        "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "status": { "enum": ["planned", "in_progress", "covered", "candidate", "blocked", "deferred", "not_applicable", "out_of_scope"] },
        "agent_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "reviewed_paths": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "result_fingerprints": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "wave": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
