#!/usr/bin/env bash
# Runs the eval PoCs of a fixture in a sanitized scratch copy, offline and
# with a time limit. Never runs anything inside this repository.
#
# Usage: evals/run-pocs <fixture-name> <scratch-dir>
#        evals/run-pocs all <scratch-dir>
#   Copies the fixture with evals/sanitize to <scratch-dir>/<fixture-name>,
#   copies evals/fixtures/<fixture-name>/pocs/*_test.go into the package named in
#   evals/fixtures/<fixture-name>/pocs/PACKAGE, and runs the PoC_ and Decoy_ tests.
#   With "all", runs every fixture under evals/fixtures/ that has a pocs/ dir
#   with Go tests, each in its own subdirectory of <scratch-dir>.
# Needs the fixtures' modules in the Go module cache (make fixtures).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
name="${1:?fixture name or 'all'}"
scratch="${2:?scratch directory}"

run_one() {
  local n="$1"
  local pocs="$here/fixtures/$n/pocs"
  local pkg dest
  pkg="$(cat "$pocs/PACKAGE")"
  dest="$scratch/$n"
  "$here/sanitize" "$n" "$dest" >/dev/null
  cp "$pocs"/*_test.go "$dest/$pkg/"
  # -mod=mod lets the go command record go.sum lines for test-only imports from
  # the module cache; GOPROXY=off keeps it offline unless EVAL_GOPROXY is set
  # (make eval-pocs sets it, after `make fixtures` has used the network anyway).
  (cd "$dest" && GOWORK=off GOFLAGS=-mod=mod GOPROXY="${EVAL_GOPROXY:-off}" \
    timeout 900 go test -count=1 -run '^Test(PoC|Decoy)_' -v "./$pkg/")
}

if [ "$name" = "all" ]; then
  status=0
  for dir in "$here"/fixtures/*/pocs; do
    [ -d "$dir" ] || continue
    ls "$dir"/*_test.go >/dev/null 2>&1 || continue
    n="$(basename "$(dirname "$dir")")"
    echo "=== run-pocs $n ==="
    if ! run_one "$n"; then
      echo "run-pocs: $n FAILED" >&2
      status=1
    fi
  done
  exit $status
fi

run_one "$name"
