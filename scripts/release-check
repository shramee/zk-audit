#!/usr/bin/env bash
# Release consistency check (repository only; not shipped with the plugin).
#
# Usage: scripts/release-check [--tag zk-audit--vX.Y.Z]
#
# Checks that the skill's VERSION, plugin.json, the marketplace entry (and
# its metadata) and the gnark-inventory Version constant agree and are
# semver, and that CHANGELOG.md has an [Unreleased] section. With --tag (the
# release workflow passes the pushed tag) it also checks that the tag is the
# one `claude plugin tag` would create (zk-audit--v<version>) and that
# CHANGELOG.md has a non-empty section for that version. Exit 1 lists every
# mismatch.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tag=""
while [ $# -gt 0 ]; do
  case "$1" in
    --tag) tag="${2:-}"; shift 2 ;;
    --tag=*) tag="${1#--tag=}"; shift ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) echo "release-check: unknown argument $1" >&2; exit 2 ;;
  esac
done
command -v jq >/dev/null || { echo "release-check: jq is required" >&2; exit 2; }
skill="$root/plugins/zk-audit/skills/zk-audit"
fail=0
bad() { echo "release-check: $*" >&2; fail=1; }

version="$(tr -d ' \n' <"$skill/VERSION")"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || bad "VERSION '$version' is not semver"
plugin="$(jq -r .version "$root/plugins/zk-audit/.claude-plugin/plugin.json")"
market="$(jq -r '.plugins[] | select(.name == "zk-audit") | .version' "$root/.claude-plugin/marketplace.json")"
meta="$(jq -r '.metadata.version // empty' "$root/.claude-plugin/marketplace.json")"
tool="$(sed -n 's/^const Version = "\(.*\)"$/\1/p' "$skill/tools/gnark-inventory/main.go")"
[ "$plugin" = "$version" ] || bad "plugin.json version $plugin != VERSION $version"
[ "$market" = "$version" ] || bad "marketplace.json zk-audit entry version $market != VERSION $version"
[ -z "$meta" ] || [ "$meta" = "$version" ] || bad "marketplace.json metadata.version $meta != VERSION $version"
[ "$tool" = "$version" ] || bad "gnark-inventory Version $tool != VERSION $version"

changelog="$root/CHANGELOG.md"
if [ ! -f "$changelog" ]; then
  bad "CHANGELOG.md is missing"
else
  grep -q '^## \[Unreleased\]' "$changelog" || bad "CHANGELOG.md has no '## [Unreleased]' section"
  if [ -n "$tag" ]; then
    [ "$tag" = "zk-audit--v$version" ] || bad "tag $tag is not zk-audit--v$version (the name claude plugin tag creates)"
    notes="$("$root/scripts/release-notes" "$version" 2>/dev/null || true)"
    [ -n "$(printf '%s' "$notes" | tr -d '[:space:]')" ] || bad "CHANGELOG.md has no non-empty '## [$version]' section; move the Unreleased entries under it"
  fi
fi
if [ $fail -ne 0 ]; then
  exit 1
fi
echo "release-check: version $version agrees across VERSION, plugin.json, marketplace.json and gnark-inventory${tag:+; tag $tag and its CHANGELOG section are in place}"
