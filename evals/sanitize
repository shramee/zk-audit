#!/usr/bin/env bash
# Copies an eval fixture to a scratch directory without its hint comments, so
# an audit run cannot read the answers from the source.
#
# Usage: evals/sanitize <fixture-name> <dest-dir>
#   fixture-name: a directory under testdata/ with a
#                 matching evals/fixtures/<fixture-name>/sanitize.sed
#   dest-dir:     must not exist yet and must be outside this repository
#
# The copy gets a fresh git repository (one commit) so worktree-based PoC runs
# work. Answer keys stay in evals/ and are never copied.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$here/.." && pwd)"
name="${1:?fixture name}"
dest="${2:?destination directory}"
src="$repo_root/testdata/$name"
rules="$here/fixtures/$name/sanitize.sed"
[ -d "$src" ] || { echo "sanitize: no fixture $src" >&2; exit 2; }
[ -f "$rules" ] || { echo "sanitize: no rules $rules" >&2; exit 2; }
[ ! -e "$dest" ] || { echo "sanitize: $dest already exists" >&2; exit 2; }
mkdir -p "$(dirname "$dest")"
dest_abs="$(cd "$(dirname "$dest")" && pwd)/$(basename "$dest")"
case "$dest_abs/" in
  "$repo_root"/*) echo "sanitize: $dest is inside the repository; use a scratch directory" >&2; exit 2 ;;
esac
cp -R "$src" "$dest_abs"
find "$dest_abs" -type f \( -name '*.go' -o -name '*.sol' \) -exec sed -i.bak -f "$rules" {} \;
find "$dest_abs" -name '*.bak' -delete
# Fail if a hint survived.
if grep -RnE '\bBUG\b|// OK:' "$dest_abs" ||
  grep -RniE 'deliberate|fixture|planted|zk-audit|answer key|unconstrained|without constraining' "$dest_abs"; then
  echo "sanitize: hint text left in $dest_abs (lines above); extend $rules" >&2
  exit 1
fi
git -C "$dest_abs" init -q
git -C "$dest_abs" add -A
git -C "$dest_abs" -c user.name=eval -c user.email=eval@localhost -c commit.gpgsign=false commit -q -m "eval snapshot"
echo "$dest_abs"
