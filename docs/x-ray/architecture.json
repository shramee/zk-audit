      "lines": [
        "/zk-audit [quick|standard|deep]",
        "/zk-audit setup | recon | diff",
        "/zk-audit:setup|recon|diff (plugin)",
        "--local --loop N --no-poc",
        "--file-output --out DIR",
        "questions → guidance mode"
      ]
    },
    {
      "id": "orch",
      "kind": "core",
      "x": 290,
      "y": 170,
      "w": 360,
      "h": 220,
      "title": "Orchestrator (main session)",
      "sub": "SKILL.md + references/orchestration.md",
      "lines": [
        "P0 Detect → P1 Recon → P2 Hunt → P3 Judge",
        "→ P4 Prove → P5 Critique → P6 Report",
        "asks one question (profile, model)",
        "completes binding-table.md, writes system-map.md",
        "saves agents/<ID>.md, updates the ledger",
        "writes findings.json; never edits REPORT.md"
      ]
    },
    {
      "id": "tool",
      "kind": "tool",
      "x": 700,
      "y": 170,
      "w": 260,
      "h": 220,
      "title": "gnark-inventory (Go, offline)",
      "sub": "{skill}/scripts → ~/.zk-audit/bin",
      "lines": [
        "detect → stack.json",
        "inventory → inventory.json/.md,",
        "  binding-table.md, ledger (seeded)",
        "bundle → bundles/<ID>.md",
        "validate findings|ledger|stack",
        "assemble → REPORT.md",
        "lint-kb · advisories · rules"
      ]
    },
    {
      "id": "out",
      "kind": "out",
      "x": 1000,
      "y": 170,
      "w": 220,
      "h": 230,
      "title": "Output (outside the repo)",
      "sub": "~/.zk-audit/<repo>/<run-id>/",
      "lines": [
        "stack.json",
        "inventory.json · inventory.md",
        "binding-table.md",
        "system-map.md",
        "coverage-ledger.json",
        "bundles/<ID>.md",
        "agents/<ID>.md",
        "findings.json",
        "REPORT.md",
        "pocs/ · worktree/ (scratch)"
      ]
    },
    {
      "id": "repo",
      "kind": "repo",
      "x": 20,
