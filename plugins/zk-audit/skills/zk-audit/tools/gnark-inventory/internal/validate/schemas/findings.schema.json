{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shramee/zk-audit/schemas/findings.schema.json",
  "$comment": "Adapted from Cloudflare security-audit-skill report-schema.json (MIT): verdict-discriminated records. zk-audit adds ZK layers, severity x confidence, evidence POC/ANALYSIS, judging gates and leads. `gnark-inventory validate findings` checks this schema plus the semantic rules in internal/validate.",
  "title": "zk-audit findings.json",
  "type": "object",
  "required": ["schema_version", "repo", "run_id", "profile", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "repo": { "type": "string", "minLength": 1 },
    "commit": { "type": "string" },
    "run_id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}$" },
    "profile": { "enum": ["quick", "standard", "deep", "local", "diff", "recon"] },
    "no_findings": { "type": "boolean" },
    "no_findings_reason": { "type": "string", "minLength": 1 },
    "posture": { "type": "string", "minLength": 1, "description": "REPORT.md section 2: three to six sentences written by the orchestrator after judging" },
    "out_of_scope": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "description": "What was left out of scope, and why" },
    "companions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "present": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "missing": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "hardening": {
      "type": "array",
      "description": "REPORT.md section 7: hygiene that is not a vulnerability",
      "items": {
        "type": "object",
        "required": ["title"],
        "additionalProperties": false,
        "properties": {
          "title": { "$ref": "#/$defs/nonEmpty" },
          "detail": { "type": "string" },
          "location": { "$ref": "#/$defs/location" }
        }
      }
    },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "fingerprint": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[^|]+\\|[^|]+\\|[a-z0-9][a-z0-9-]*$",
      "description": "group_key: circuit|signal-or-gadget|bug-class or contract|function|bug-class"
    },
    "location": {
      "type": "object",
      "required": ["file", "line", "scope"],
      "additionalProperties": false,
      "properties": {
        "file": { "$ref": "#/$defs/nonEmpty" },
        "line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "scope": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "common": {
      "type": "object",
      "required": ["fingerprint", "verdict", "title", "layer", "bug_class", "location", "detected_by", "description"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "verdict": { "enum": ["confirmed", "needs_validation", "rejected", "lead"] },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "layer": { "enum": ["circuit", "integration", "prover", "dependency", "setup"] },
        "bug_class": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "location": { "$ref": "#/$defs/location" },
        "related_locations": { "type": "array", "items": { "$ref": "#/$defs/location" } },
        "detected_by": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "vector_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^V-[A-Z]+[0-9]+$" } },
        "description": { "$ref": "#/$defs/nonEmpty" },
        "run_tag": { "enum": ["NEW", "KNOWN"], "description": "Loop mode, set by `gnark-inventory memory merge`: NEW when first seen in the latest pass, KNOWN when seen in an earlier one" },
        "seen": {
          "type": "object",
          "required": ["passes", "of"],
          "additionalProperties": false,
          "description": "Loop mode, set by `gnark-inventory memory merge`: in how many of the passes run so far the fingerprint was reported",
          "properties": { "passes": { "type": "integer", "minimum": 1 }, "of": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "trust": {
      "type": "object",
      "required": ["party", "role", "power", "breaks", "assumption"],
      "additionalProperties": false,
      "description": "A trusted-party item (judging.md Gate 3): who holds the power, what it breaks, and the assumption users carry. `validate findings` checks the verdict and severity rules.",
      "properties": {
        "party": { "$ref": "#/$defs/nonEmpty", "description": "Who holds the power, as the code names it (owner of Vault, UPDATER_ROLE, the setup ceremony)" },
        "role": { "enum": ["owner", "admin", "role", "upgrader", "deployer", "setup", "prover", "sequencer", "relayer", "oracle", "service", "other"] },
        "power": { "$ref": "#/$defs/nonEmpty", "description": "What the party can do, in one sentence" },
        "breaks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["soundness", "funds", "liveness", "privacy"] } },
        "assumption": { "$ref": "#/$defs/nonEmpty", "description": "The trust assumption users carry, as a statement" },
        "mitigation": { "type": "string", "description": "What the repository shows that limits the power (timelock, multisig owner, multi-party ceremony), with file:line; empty or absent when none" },
        "accepted": { "type": "boolean", "description": "zk-audit.md marks the party trusted or lists this power as an accepted risk" },
        "source": { "type": "string", "pattern": "^zk-audit\\.md(:[0-9]+(-[0-9]+)?)?$", "description": "Where zk-audit.md accepts it, e.g. zk-audit.md:12" },
        "lead_reason": { "$ref": "#/$defs/nonEmpty", "description": "Only for a lead: why the power itself is not established" }
      }
    },
    "fix": {
      "type": "object",
      "required": ["summary"],
      "additionalProperties": false,
      "properties": {
        "summary": { "$ref": "#/$defs/nonEmpty" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "diff"],
            "additionalProperties": false,
            "properties": {
              "label": { "$ref": "#/$defs/nonEmpty" },
              "diff": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        }
      }
    },
    "poc": {
      "type": "object",
      "required": ["path", "command", "result"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/nonEmpty" },
        "command": { "$ref": "#/$defs/nonEmpty" },
        "result": {
          "enum": ["demonstrated", "demonstrated_on_model", "not_demonstrated", "does_not_compile", "not_run"],
          "description": "demonstrated: the attack passed against the production circuit or contract, with the honest control and sanity case; demonstrated_on_model: only a model of the circuit (T-CONSTRAINT-MODEL) shows it, so evidence stays ANALYSIS"
        },
        "demonstrates": { "enum": ["soundness", "completeness"], "description": "Which property the PoC breaks: a false statement accepted (soundness) or an honest statement rejected (completeness)" },
        "package": { "$ref": "#/$defs/nonEmpty", "description": "Repository-relative directory the PoC file is copied into (Go package or Foundry root) to re-run it in a fresh worktree" },
        "output_excerpt": { "type": "string" }
      }
    },
    "gates": {
      "type": "object",
      "required": ["executes", "reachable", "unprivileged", "impact"],
      "additionalProperties": false,
      "properties": {
        "executes": { "$ref": "#/$defs/nonEmpty" },
        "reachable": { "$ref": "#/$defs/nonEmpty" },
        "unprivileged": { "$ref": "#/$defs/nonEmpty" },
        "impact": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "refuter": {
      "type": "object",
      "required": ["verdict", "reasoning"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "enum": ["exploitable", "not_exploitable", "uncertain"] },
        "reasoning": { "$ref": "#/$defs/nonEmpty" },
        "mechanism": { "enum": ["holds", "refuted", "uncertain"], "description": "Does the claimed mechanism (the free value, the missing check) exist?" },
        "impact": { "enum": ["holds", "refuted", "uncertain"], "description": "Does it harm anyone as claimed? A real mechanism with no victim is mechanism: holds, impact: refuted" },
        "by": { "type": "string" }
      }
    },
    "confirmed": {
      "allOf": [{ "$ref": "#/$defs/common" }],
      "type": "object",
      "required": ["severity", "confidence", "evidence", "proof", "impact", "gates"],
      "additionalProperties": false,
      "properties": {
        "fingerprint": true, "verdict": { "const": "confirmed" }, "title": true, "layer": true, "bug_class": true,
        "location": true, "related_locations": true, "detected_by": true, "vector_ids": true,
        "description": true, "run_tag": true, "seen": true, "trust": { "$ref": "#/$defs/trust" },
        "severity": { "$ref": "#/$defs/severity" },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "evidence": { "enum": ["POC", "ANALYSIS"] },
        "proof": { "$ref": "#/$defs/nonEmpty" },
        "impact": { "$ref": "#/$defs/nonEmpty" },
        "gates": { "$ref": "#/$defs/gates" },
        "fix": { "$ref": "#/$defs/fix" },
        "poc": { "$ref": "#/$defs/poc" },
        "refuter": { "$ref": "#/$defs/refuter" },
        "chain": { "type": "array", "items": { "$ref": "#/$defs/fingerprint" } }
      }
    },
    "needs_validation": {
      "allOf": [{ "$ref": "#/$defs/common" }],
      "type": "object",
      "required": ["severity", "confidence", "blockers", "validation_plan"],
      "additionalProperties": false,
      "properties": {
        "fingerprint": true, "verdict": { "const": "needs_validation" }, "title": true, "layer": true, "bug_class": true,
        "location": true, "related_locations": true, "detected_by": true, "vector_ids": true,
        "description": true, "run_tag": true, "seen": true, "trust": { "$ref": "#/$defs/trust" },
        "severity": { "$ref": "#/$defs/severity" },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "proof": { "type": "string" },
        "impact": { "type": "string" },
        "blockers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "validation_plan": { "$ref": "#/$defs/nonEmpty" },
        "fix": { "$ref": "#/$defs/fix" },
        "poc": { "$ref": "#/$defs/poc" },
        "refuter": { "$ref": "#/$defs/refuter" }
      }
    },
    "rejected": {
      "allOf": [{ "$ref": "#/$defs/common" }],
      "type": "object",
      "required": ["reason", "refuting_location"],
      "additionalProperties": false,
      "properties": {
        "fingerprint": true, "verdict": { "const": "rejected" }, "title": true, "layer": true, "bug_class": true,
        "location": true, "related_locations": true, "detected_by": true, "vector_ids": true,
        "description": true, "run_tag": true, "seen": true, "trust": { "$ref": "#/$defs/trust" },
        "reason": { "$ref": "#/$defs/nonEmpty" },
        "refuting_location": { "$ref": "#/$defs/location" },
        "poc": { "$ref": "#/$defs/poc" },
        "refuter": { "$ref": "#/$defs/refuter" }
      }
    },
    "lead": {
      "allOf": [{ "$ref": "#/$defs/common" }],
      "type": "object",
      "required": ["code_smells", "unverified"],
      "additionalProperties": false,
      "properties": {
        "fingerprint": true, "verdict": { "const": "lead" }, "title": true, "layer": true, "bug_class": true,
        "location": true, "related_locations": true, "detected_by": true, "vector_ids": true,
        "description": true, "run_tag": true, "seen": true, "trust": { "$ref": "#/$defs/trust" },
        "code_smells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "unverified": { "$ref": "#/$defs/nonEmpty" },
        "poc": { "$ref": "#/$defs/poc", "description": "A demoted record keeps the PoC that was built for it" },
        "refuter": { "$ref": "#/$defs/refuter" }
      }
    },
    "record": {
      "oneOf": [
        { "$ref": "#/$defs/confirmed" },
        { "$ref": "#/$defs/needs_validation" },
        { "$ref": "#/$defs/rejected" },
        { "$ref": "#/$defs/lead" }
      ]
    }
  }
}
