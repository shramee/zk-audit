package PKG

// Shared circuit of the version matrix: Q = A / B through a hint whose
// remainder is never range-checked, so (Q - 1, R + B) also satisfies it.

import (
	"math/big"

	"github.com/consensys/gnark/frontend"
)

// divHint returns the quotient and remainder of inputs[0] / inputs[1].
func divHint(_ *big.Int, in, out []*big.Int) error {
	out[0].Quo(in[0], in[1])
	out[1].Rem(in[0], in[1])
	return nil
}

// Circuit proves knowledge of A, B with A / B = Q.
type Circuit struct {
	A, B frontend.Variable
	Q    frontend.Variable `gnark:",public"`
}

// Define binds Q to the hinted quotient.
func (c *Circuit) Define(api frontend.API) error {
	res, err := api.Compiler().NewHint(divHint, 2, c.A, c.B)
	if err != nil {
		return err
	}
	api.AssertIsEqual(api.Add(api.Mul(res[0], c.B), res[1]), c.A)
	api.AssertIsEqual(res[0], c.Q)
	return nil
}

// evilDiv answers 17 / 5 with (2, 7): 2 * 5 + 7 = 17.
func evilDiv(_ *big.Int, in, out []*big.Int) error {
	out[0].SetInt64(2)
	out[1].SetInt64(7)
	return nil
}
