#!/usr/bin/env bash
# Runs the Foundry PoCs of a fixture in a sanitized scratch copy. Never runs
# anything inside this repository. Requires `forge` on PATH (no forge-std; the
# PoCs declare their own mocks and assert with require).
#
# Usage: evals/run-foundry-pocs <fixture-name> <scratch-dir>
#        evals/run-foundry-pocs all <scratch-dir>
#   Copies the fixture with evals/sanitize, copies
#   evals/fixtures/<fixture>/pocs/*.t.sol into the project's test/ directory and
#   runs `forge test`. With "all", runs every fixture that has a pocs/*.t.sol.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
name="${1:?fixture name or 'all'}"
scratch="${2:?scratch directory}"

command -v forge >/dev/null || { echo "run-foundry-pocs: forge not found" >&2; exit 2; }

run_one() {
  local n="$1"
  local pocs="$here/fixtures/$n/pocs"
  local dest="$scratch/$n"
  "$here/sanitize" "$n" "$dest" >/dev/null
  mkdir -p "$dest/test"
  cp "$pocs"/*.t.sol "$dest/test/"
  (cd "$dest" && FOUNDRY_OFFLINE=true forge test)
}

if [ "$name" = "all" ]; then
  status=0
  for dir in "$here"/fixtures/*/pocs; do
    [ -d "$dir" ] || continue
    ls "$dir"/*.t.sol >/dev/null 2>&1 || continue
    n="$(basename "$(dirname "$dir")")"
    echo "=== run-foundry-pocs $n ==="
    if ! run_one "$n"; then
      echo "run-foundry-pocs: $n FAILED" >&2
      status=1
    fi
  done
  exit $status
fi

run_one "$name"
